{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "north_star_id", "decisions"],
  "properties": {
    "schema_version": {"const": "decision-registry.v1"},
    "project_id": {"type": "string", "minLength": 1},
    "north_star_id": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "title", "decision_class", "status", "question",
          "hard_constraints", "criteria_weights", "selected_option",
          "rationale", "evidence_refs", "reconsideration_triggers"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "decision_class": {"enum": ["D1_LIGHTWEIGHT", "D2_STRUCTURED", "D3_HIGH_CONSEQUENCE"]},
          "status": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "hard_constraints": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "options_considered": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "options_to_research": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "criteria_weights": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100}},
          "selected_option": {"type": ["string", "null"]},
          "rationale": {"type": ["string", "null"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "reconsideration_triggers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
