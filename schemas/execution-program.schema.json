{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-program.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "north_star_id",
    "program_id",
    "program_version",
    "status",
    "work_packages",
    "tasks"
  ],
  "properties": {
    "schema_version": {"const": "execution-program.v1"},
    "project_id": {"type": "string", "minLength": 1},
    "north_star_id": {"type": "string", "minLength": 1},
    "program_id": {"type": "string", "minLength": 1},
    "program_version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "work_packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "objective", "task_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "task_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "minItems": 1}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "work_package_id", "title", "status", "depends_on", "scope_ref", "acceptance_criteria", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "work_package_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "scope_ref": {"type": "string", "minLength": 1},
          "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": ["object", "string"],
              "additionalProperties": false,
              "required": ["receipt_type", "verification_type", "subject_kind", "repository", "ref", "subject_sha", "transition_from", "transition_to"],
              "properties": {
                "receipt_type": {"type": "string", "minLength": 1},
                "verification_type": {"type": "string", "minLength": 1},
                "subject_kind": {"type": "string", "minLength": 1},
                "repository": {"type": "string", "minLength": 1},
                "ref": {"type": "string", "minLength": 1},
                "subject_sha": {"type": "string", "minLength": 1},
                "transition_from": {"type": "string", "minLength": 1},
                "transition_to": {"type": "string", "minLength": 1}
              }
            },
            "uniqueItems": true
          },
          "blocker": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["code", "reason", "evidence_refs"],
            "properties": {
              "code": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "minItems": 1}
            }
          }
        }
      }
    }
  }
}
